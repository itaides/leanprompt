{
    "name": "leanprompt-mcp-proxy",
    "version": "0.1.1",
    "description": "MCP proxy that compresses oversized tool results and sampling requests with leanprompt before they reach the model.",
    "author": "itaides",
    "license": "MIT",
    "homepage": "https://github.com/itaides/leanprompt",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/itaides/leanprompt.git",
        "directory": "mcp-proxy"
    },
    "type": "module",
    "main": "./dist/proxy.js",
    "types": "./dist/proxy.d.ts",
    "bin": {
        "leanprompt-mcp-proxy": "./dist/cli.js"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "check-version": "node -e 'const fs=require(\"node:fs\");const v=fs.readFileSync(\"src/version.ts\",\"utf8\").match(/VERSION = \"([^\"]+)\"/);const p=require(\"./package.json\").version;if(!v||v[1]!==p){console.error(\"version mismatch: src/version.ts \"+(v?v[1]:\"?\")+\" != package.json \"+p);process.exit(1)}'",
        "pretest": "npm run check-version",
        "test": "bun test",
        "prepack": "node -e 'const d=(require(\"./package.json\").dependencies||{}).leanprompt||\"\";if(d.startsWith(\"file:\")){console.error(\"leanprompt dependency is a file: link; point it at the released leanprompt version range before packing\");process.exit(1)}'",
        "clean": "rm -rf dist"
    },
    "dependencies": {
        "leanprompt": "file:../ts",
        "@modelcontextprotocol/sdk": "^1.30.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "typescript": "^5.5.0"
    },
    "engines": {
        "node": ">=18"
    }
}
