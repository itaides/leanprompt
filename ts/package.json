{
    "name": "leanprompt",
    "version": "0.1.1",
    "description": "Zero-dependency prompt compression for LLM applications: deterministic extractive compressor, classifier-gated pipeline, fetch middleware and minimal clients.",
    "keywords": [
        "llm",
        "prompt-compression",
        "anthropic",
        "openai",
        "gemini",
        "rag",
        "context",
        "tokens"
    ],
    "author": "itaides",
    "license": "MIT",
    "homepage": "https://github.com/itaides/leanprompt",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/itaides/leanprompt.git",
        "directory": "ts"
    },
    "bugs": {
        "url": "https://github.com/itaides/leanprompt/issues"
    },
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./langchain": {
            "types": "./dist/integrations/langchain.d.ts",
            "import": "./dist/integrations/langchain.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "test": "bun test",
        "clean": "rm -rf dist"
    },
    "peerDependencies": {
        "@langchain/anthropic": ">=1.0.0",
        "@langchain/core": ">=1.0.0",
        "@langchain/openai": ">=1.0.0"
    },
    "peerDependenciesMeta": {
        "@langchain/anthropic": { "optional": true },
        "@langchain/core": { "optional": true },
        "@langchain/openai": { "optional": true }
    },
    "devDependencies": {
        "@langchain/anthropic": "^1.5.2",
        "@langchain/core": "^1.2.3",
        "@langchain/openai": "^1.5.5",
        "@types/node": "^22.0.0",
        "typescript": "^5.5.0"
    },
    "engines": {
        "node": ">=18"
    }
}
